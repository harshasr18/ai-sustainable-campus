# AI Sustainable Campus — environment template
# Copy to `.env` and fill in. `.env` is git-ignored; NEVER commit real values.
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# Leave DATABASE_URL EMPTY to use PGlite (PostgreSQL compiled to WASM) — real
# PostgreSQL semantics, no server to install, nothing to configure. This is the
# recommended hackathon setup and the default for `npm test`.
#
# Set DATABASE_URL to use a native PostgreSQL server instead (recommended for the
# final demo, since PGlite is single-process).
#   postgres://USER:PASSWORD@localhost:5432/campus
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=
DATABASE_URL=

# On-disk location for PGlite (only used when DATABASE_URL is empty).
# Used by `npm run migrate` and `npm run seed` so data survives between commands.
PGLITE_DIR=.data/campus

# ─────────────────────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────────────────────
# Session lifetime in hours.
SESSION_TTL_HOURS=8

# Login attempts per minute per IP (brute-force protection).
LOGIN_RATE_LIMIT_MAX=10
# Global requests per minute per IP.
RATE_LIMIT_MAX=300

# Password for the seeded DEMO accounts. If you leave this blank, `npm run seed`
# generates a cryptographically random password and prints it once to the terminal.
# Set it to something fixed for a predictable demo. Never reuse a real password.
DEMO_SEED_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# EVIDENCE (student photograph) STORAGE
# Stored OUTSIDE any public/static directory. Never served without authorization.
# ─────────────────────────────────────────────────────────────────────────────
EVIDENCE_DIR=storage/evidence
# Maximum upload size per photograph, in bytes (default 8 MiB).
MAX_EVIDENCE_BYTES=8388608
# Minutes a server-issued camera ticket stays valid, from shutter press to Submit.
# A report must present an unexpired, unused ticket belonging to the submitting user.
CAPTURE_SESSION_TTL_MINUTES=15

# ─────────────────────────────────────────────────────────────────────────────
# AI PIPELINE (Phase 2)
#
# The classifier runs LOCALLY on CPU. It is free, needs no API key, and never
# uploads a student's photograph anywhere. See docs/AI_MODEL.md.
#
#   AI_PROVIDER=unconfigured  ->  /v1/reports/:id/analyze returns 501. Honest default.
#   AI_PROVIDER=local-clip    ->  real CLIP ViT-B/32 inference, on device.
#
# There is deliberately no value that turns AI on by accident.
# ─────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=unconfigured

# Model id, as published on Hugging Face. Weights are ~149 MB, downloaded once into
# AI_CACHE_DIR. Pre-download before an offline demo: `npm run ai:warm`.
AI_MODEL=Xenova/clip-vit-base-patch32

# Where the quantized ONNX weights are cached.
AI_CACHE_DIR=.cache/hf

# Set to false for an air-gapped demo. Then the weights MUST already be in AI_CACHE_DIR,
# or analysis fails loudly rather than silently reaching for the network.
AI_ALLOW_REMOTE_DOWNLOAD=true

# Human-review policy. A result is sent to a human when confidence is below the
# threshold, when the top two categories are closer than the margin, or when the model
# disagrees with the student. Defaults mirror AI_REVIEW_CONFIDENCE_THRESHOLD in the
# shared contract; the application refuses to start if the threshold is out of range.
AI_CONFIDENCE_THRESHOLD=0.7
AI_AMBIGUITY_MARGIN=0.15

# Per-attempt inference timeout and total attempts for TRANSIENT failures only.
# A permanent failure (undecodable image) is never retried.
AI_TIMEOUT_MS=30000
AI_MAX_ATTEMPTS=3

# Background analysis worker (polls for reports with validation_status='PENDING').
AI_WORKER_ENABLED=true
AI_WORKER_INTERVAL_MS=2000
