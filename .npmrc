# Why `legacy-peer-deps` is set at the repository level, and not left as a step someone
# has to remember.
#
# `npm install` fails on this dependency tree with npm 10.8.2:
#
#     npm error Cannot read properties of null (reading 'edgesOut')
#         at #loadPeerSet (.../@npmcli/arborist/lib/arborist/build-ideal-tree.js:1286)
#
# This is a bug in npm's own peer-dependency resolver, not a conflict in this project. It is
# triggered by @react-three/fiber (Phase 3's 3D twin dependency), which declares an OPTIONAL
# peer dependency on react-native for its native entry point. Trying to resolve that peer set
# recursively pulls in react-native, react-native-reanimated, react-native-worklets and
# @react-native/metro-config, and the walk crashes.
#
# Verified: with this flag the install completes cleanly — 306 packages, and `npm audit`
# reports the same 5 moderate / 0 high findings as before the frontend dependencies were
# added. Without it, a fresh clone cannot be installed at all.
#
# WHAT THIS COSTS. npm will no longer auto-install or enforce peer dependencies. That is an
# acceptable trade here — this is a small, deliberately chosen dependency set and the peer
# relationships are all satisfied explicitly — but it is a real trade and it is the reason
# this file exists rather than a quiet flag in a script.
#
# Revisit when npm ships a fixed arborist (or if @react-three/fiber drops its react-native
# peer). Removing this file is the test: if `rm .npmrc && npm install` succeeds, the bug is
# gone and the flag should go with it.
legacy-peer-deps=true
