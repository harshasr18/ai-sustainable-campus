{
  "name": "ai-sustainable-campus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrate": "tsx packages/db/src/cli-migrate.ts",
    "seed": "tsx packages/db/src/cli-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:reset:dry": "tsx scripts/db-reset.ts --dry-run",
    "dev": "tsx watch apps/api/src/server.ts",
    "start": "tsx apps/api/src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ai:warm": "tsx scripts/ai-warm.ts",
    "ai:eval-prompts": "node scripts/ai-eval-prompts.mjs",
    "worker:verify": "node tools/verify-worker.mjs",
    "smoke:api": "node scripts/smoke-test.mjs",
    "smoke:web": "node tools/smoke-web.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@fastify/multipart": "^9",
    "@fastify/rate-limit": "^10",
    "@huggingface/transformers": "^3.8.1",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^6.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.6",
    "pino-pretty": "^13",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
